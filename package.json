{
  "name": "coliseum",
  "version": "3.9.0",
  "description": "Modern Chess Engine Tournament Manager",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "author": "Rinarto Gibson",
  "license": "MIT",
  "dependencies": {
    "chess-opening-book-reader": "^0.1.0",
    "chess.js": "^1.0.0-beta.8",
    "clsx": "^2.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.3",
    "glicko2": "^1.2.1",
    "lucide-react": "^0.316.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.2.1",
    "tmi.js": "^1.8.5",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.coliseum.app",
    "productName": "Coliseum",
    "publish": [
      {
        "provider": "github",
        "owner": "PhelRin",
        "repo": "Coliseum"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "books",
        "to": "books",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "extraFiles": [
        {
          "from": "Engines",
          "to": "engines",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/linux",
      "synopsis": "Chess engine tournaments, testing and training",
      "description": "Coliseum runs chess engine tournaments, SPRT tests and Elo estimation, and lets you play and train against engines.",
      "maintainer": "Rinarto Gibson",
      "executableName": "coliseum",
      "artifactName": "Coliseum-${version}-${arch}.${ext}",
      "extraFiles": [
        {
          "from": "Engines-linux",
          "to": "engines",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "coliseum_${version}_${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
